{
  "name": "Steele Family Recipe Vault",
  "short_name": "Recipe Vault",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#fbf4e9",
  "theme_color": "#1f2a36",
  "icons": [
    {
      "src": "/static/icon-192.png?v=3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-maskable-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/import",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "video/*",
            "image/*"
          ]
        }
      ]
    }
  }
}
