{
  "name": "Steele Family Recipe Vault",
  "short_name": "Recipe Vault",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#fbf4e9",
  "theme_color": "#1f2a36",
  "icons": [
    { "src": "/static/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "/import",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [ { "name": "media", "accept": ["video/*", "image/*"] } ]
    }
  }
}
